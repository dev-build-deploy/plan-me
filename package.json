{
  "name": "plan-me",
  "version": "0.0.1",
  "private": false,
  "description": "Deterministic GitHub backlog management (Issues + Projects v2) for humans and LLMs",
  "author": "Kevin de Jong",
  "license": "MIT",
  "homepage": "https://github.com/dev-build-deploy/plan-me",
  "keywords": [
    "github",
    "action",
    "backlog",
    "projects",
    "mcp"
  ],
  "bugs": {
    "url": "https://github.com/dev-build-deploy/plan-me/issues"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:cli": "ncc build -o lib/cli src/entrypoints/cli.ts",
    "build:action": "ncc build -o lib/action src/entrypoints/action.ts",
    "test": "jest --coverage",
    "lint": "eslint --ext .ts .",
    "format": "prettier --write **/*.ts && prettier --write **/**/*.ts",
    "prepare": "node -e \"if(process.env.CI)process.exit(0);const r=require('child_process').spawnSync('pre-commit',['install','--hook-type','pre-commit','--hook-type','commit-msg'],{stdio:'inherit'});if(r.error)console.log('hint: install pre-commit (https://pre-commit.com) to get the git hooks')\""
  },
  "bin": {
    "plan-me": "./bin/plan-me"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "jest": "^29.7.0",
    "npm-run-all2": "^6.2.6",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
